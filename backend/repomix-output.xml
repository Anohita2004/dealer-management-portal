      },

      slaEnd: {
        type: DataTypes.DATE,
        allowNull: true,
      },

      // Metadata
      metadata: {
        type: DataTypes.JSONB,
        allowNull: true,
        defaultValue: {},
      },
    },
    {
      tableName: 'workflow_timelines',
      timestamps: true,
      indexes: [
        {
          fields: ['entityType', 'entityId'],
        },
        {
          fields: ['actorId'],
        },
        {
          fields: ['stage'],
        },
        {
          fields: ['createdAt'],
        },
      ],
    }
  );

  WorkflowTimeline.associate = (models) => {
    WorkflowTimeline.belongsTo(models.User, {
      foreignKey: 'actorId',
      as: 'actor',
      onDelete: 'SET NULL',
    });
  };

  return WorkflowTimeline;
};
