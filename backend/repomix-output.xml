  console.log('\n⏱️  Server startup timeout (10s)');
  console.log('\n📋 Logs captured:');
  logs.forEach(log => console.log('  ', log));
  if (errors.length > 0) {
    console.log('\n❌ Errors captured:');
    errors.forEach(err => console.log('  ', err));
  }
  process.exit(1);
}, 10000);

try {
  // Try to start server
