// src/controllers/areaController.js
const { Area, Region, Territory, Dealer, sequelize } = require('../models');

// Create new area
const createArea = async (req, res) => {
  try {
    const { name, regionId, geojson, centroidLat, centroidLng } = req.body;

    // Validate region exists
    const region = await Region.findByPk(regionId);
    if (!region) {
      return res.status(404).json({ error: 'Region not found' });
    }

    // Check hierarchical permissions
    const userRole = req.user.roleDetails?.name || req.user.role;
    if (userRole === 'regional_admin' && req.user.regionId !== regionId) {
      return res.status(403).json({ error: 'Cannot create areas outside your region' });
    }

    const area = await Area.create({
      name,
      regionId,
      geojson,
      centroidLat,
      centroidLng
    });

    res.status(201).json({ message: 'Area created successfully', area });
  } catch (err) {
    console.error('createArea:', err);
    res.status(500).json({ error: 'Failed to create area' });
  }
};

// Get all areas (scoped by user role)
const getAreas = async (req, res) => {
  try {
    const whereClause = {};
    const userRole = req.user.roleDetails?.name || req.user.role;

    if (userRole === 'regional_admin') {
      whereClause.regionId = req.user.regionId;
    }

    const areas = await Area.findAll({
      where: whereClause,
      include: [
        {
          model: Region,
          as: 'region',
          attributes: ['id', 'name']
        },
        {
          model: Territory,
          as: 'territories',
          attributes: ['id', 'name']
        }
      ],
      order: [['name', 'ASC']]
    });

    res.json({ areas });
  } catch (err) {
    console.error('getAreas:', err);
    res.status(500).json({ error: 'Failed to fetch areas' });
  }
};

// Get single area with full details
const getArea = async (req, res) => {
  try {
    const { id } = req.params;

    const area = await Area.findByPk(id, {
      include: [
        {
          model: Region,
          as: 'region',
          attributes: ['id', 'name', 'geojson']
        },
        {
          model: Territory,
          as: 'territories',
          include: [{
            model: Dealer,
            as: 'dealers',
            attributes: ['id', 'businessName', 'dealerCode', 'lat', 'lng']
          }]
        }
      ]
    });

    if (!area) {
      return res.status(404).json({ error: 'Area not found' });
    }

    // Check access permissions
    const userRole = req.user.roleDetails?.name || req.user.role;
    if (userRole === 'regional_admin' && area.regionId !== req.user.regionId) {
      return res.status(403).json({ error: 'Access denied' });
    }

    res.json({ area });
  } catch (err) {
    console.error('getArea:', err);
    res.status(500).json({ error: 'Failed to fetch area' });
  }
};

// Update area
const updateArea = async (req, res) => {
  try {
    const { id } = req.params;
    const { name, geojson, centroidLat, centroidLng } = req.body;

    const area = await Area.findByPk(id);
    if (!area) {
      return res.status(404).json({ error: 'Area not found' });
    }

    // Check permissions
    const userRole = req.user.roleDetails?.name || req.user.role;
    if (userRole === 'regional_admin' && area.regionId !== req.user.regionId) {
      return res.status(403).json({ error: 'Cannot modify areas outside your region' });
    }

    await area.update({
      name: name || area.name,
      geojson: geojson || area.geojson,
      centroidLat: centroidLat || area.centroidLat,
      centroidLng: centroidLng || area.centroidLng
    });

    res.json({ message: 'Area updated successfully', area });
  } catch (err) {
    console.error('updateArea:', err);
    res.status(500).json({ error: 'Failed to update area' });
  }
};

// Delete area (with validation)
const deleteArea = async (req, res) => {
  const t = await sequelize.transaction();
  try {
    const { id } = req.params;

    const area = await Area.findByPk(id, {
      include: [
        { model: Territory, as: 'territories' },
        { model: Dealer, as: 'dealers' }
      ],
      transaction: t
    });

    if (!area) {
      return res.status(404).json({ error: 'Area not found' });
    }

    // Check if area has territories or dealers
    if (area.territories && area.territories.length > 0) {
      return res.status(400).json({
        error: 'Cannot delete area that contains territories. Move territories first.'
      });
    }

    if (area.dealers && area.dealers.length > 0) {
      return res.status(400).json({
        error: 'Cannot delete area that contains dealers. Reassign dealers first.'
      });
    }

    // Check permissions
    const userRole = req.user.roleDetails?.name || req.user.role;
    if (userRole === 'regional_admin' && area.regionId !== req.user.regionId) {
      return res.status(403).json({ error: 'Cannot delete areas outside your region' });
    }

    await area.destroy({ transaction: t });
    await t.commit();

    res.json({ message: 'Area deleted successfully' });
  } catch (err) {
    await t.rollback();
    console.error('deleteArea:', err);
    res.status(500).json({ error: 'Failed to delete area' });
  }
};

module.exports = {
  createArea,
  getAreas,
  getArea,
  updateArea,
  deleteArea
};
