            }
          }
        }
        break;

      case 'finance_admin':
        // 9️⃣ FINANCE ADMIN
        // CAN: Super Admin, Technical Admin, Regional Admin, Dealer Admin, Accounts User, Territory / Area Managers (for clarifications)
        // CANNOT: Dealer Staff directly (unless needed)
        {
