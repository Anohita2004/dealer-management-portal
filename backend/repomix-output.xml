    }

    const warehouse = await Warehouse.create({
      warehouseCode,
      name,
      address,
      city,
      state,
      pincode,
      lat,
      lng,
      regionId,
      areaId,
      contactPerson,
      phoneNumber,
      email,
      isActive: true,
    });

