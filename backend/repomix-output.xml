    console.log(`   Order ID: ${orderId}`);
    console.log(`   Invoice ID: ${invoiceId}`);
    console.log(`   Payment ID: ${paymentId}`);
  } else {
    console.log('\n❌ Flow incomplete - check errors above');
  }
  
  return testResult;
}

