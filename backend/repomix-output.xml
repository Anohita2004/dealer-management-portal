  return false;
}

// Step 5: Create Invoice from Order
async function createInvoice(orderId, token) {
  console.log('\n📄 Step 5: Creating invoice from order...');
  
  if (!orderId) {
    console.log('❌ Cannot create invoice: No order ID');
    return null;
  }
  
  // First check order status
