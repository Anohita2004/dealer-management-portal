<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Create Delivery Order">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Sales Order Number (VBELN)"/>
                <Input id="inputVbeln" />
                
                <Label text="Delivery Date"/>
                <DatePicker id="inputDate" />

                <Label text="Storage Location"/>
                <Select id="inputSloc" items="{masterData>/storageLocations}">
                    <core:Item key="{masterData>key}" text="{masterData>text}" />
                </Select>

                <Label text="Loading Point"/>
                <ComboBox id="inputLoadingPoint" items="{masterData>/loadingPoints}">
                    <core:Item key="{masterData>key}" text="{masterData>text}" />
                </ComboBox>
            </VBox>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press="onCreateSubmit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCreateCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
