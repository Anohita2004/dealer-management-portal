<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Create Delivery Order">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Sales Order Number (VBELN)"/>
                <Input id="inputVbeln" />
                
                <Label text="Delivery Date"/>
                <DatePicker id="inputDate" />

                <Label text="Storage Location"/>
                <Input id="inputSloc" placeholder="UUID of Storage Location" />
                <!-- In real app, use Select with items="{/storageLocations}" -->

                <Label text="Loading Point"/>
                <Input id="inputLoadingPoint" placeholder="UUID of Loading Point" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press="onCreateSubmit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCreateCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
