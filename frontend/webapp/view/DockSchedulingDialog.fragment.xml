<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Schedule Dock">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Delivery Order ID"/>
                <Input id="inputScheduleDoId" editable="false" />

                <Label text="Loading Point"/>
                <Input id="inputScheduleLp" placeholder="Loading Point ID" />

                <Label text="Start Time"/>
                <DateTimePicker id="inputScheduleStart" />

                <Label text="End Time"/>
                <DateTimePicker id="inputScheduleEnd" />
            </VBox>
        </content>
        <beginButton>
            <Button text="Schedule" type="Emphasized" press="onScheduleSubmit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onScheduleCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
